# Anthropic Claude API Key (required)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx

# Secret key for session signing (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-random-secret

# Data directory (mapped to Docker volume)
DATA_DIR=/data

# Whisper model size: tiny (39MB) / base (74MB) / small (244MB)
# Use tiny for slow ARM NAS, base for most NAS, small for x86 NAS
WHISPER_MODEL=base

# TTS voice (Chinese voices)
# zh-CN-XiaoxiaoNeural (female) / zh-CN-YunxiNeural (male)
TTS_VOICE=zh-CN-XiaoxiaoNeural

# Timezone
TZ=Asia/Shanghai

# Log level: debug / info / warning / error
LOG_LEVEL=info

# Host port mapping (NAS port → container port 8080)
HOST_PORT=8080

# Data path on NAS (absolute path on NAS host)
DATA_PATH=./data
